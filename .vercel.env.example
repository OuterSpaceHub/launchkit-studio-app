# Vercel Environment Variables Template
# Copy these values into Vercel Project Settings > Environment Variables.
# Use the same values for local .env.local if desired.

# Public envs
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<supabase-anon-key>
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_xxx

# Server-only envs
SUPABASE_SERVICE_ROLE_KEY=<supabase-service-role-key>
STRIPE_SECRET_KEY=sk_live_xxx
STRIPE_PRICE_ID=price_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Local dev only (optional):
# NEXTAUTH_URL=http://localhost:3000

# Notes:
# - Do not expose SUPABASE_SERVICE_ROLE_KEY or STRIPE_SECRET_KEY to browser code.
# - In Vercel, set server-only envs for the Production and Preview environments
#   and keep the NEXT_PUBLIC_* values available to the client.
# - To test locally, copy this file to .env.local and replace the placeholder values.
